# Neon Astro Stack 环境变量示例
# 复制为 .env 并修改实际值

# PostgreSQL
POSTGRES_DB=neon_astro
POSTGRES_USER=neon
POSTGRES_PASSWORD=neon123

# Redis
REDIS_PASSWORD=neon123

# JWT
JWT_SECRET=bmVvbi1hc3Ryby1zdGFjay1qd3Qtc2VjcmV0LWtleS1mb3ItcHJvZHVjdGlvbi0yMDI2

# AI 占星师模型（OpenAI 兼容接口）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini

# 前端
VITE_API_BASE_URL=/api/v1
